# =============================================================================
# CRYONIX ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to apps/web/.env.local and fill in your values
# DO NOT commit .env.local to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE (Vercel Postgres)
# -----------------------------------------------------------------------------
# Get these from Vercel Dashboard > Storage > Postgres
POSTGRES_URL="postgres://user:password@host:5432/database?sslmode=require"
POSTGRES_PRISMA_URL="postgres://user:password@host:5432/database?sslmode=require&pgbouncer=true"
POSTGRES_URL_NON_POOLING="postgres://user:password@host:5432/database?sslmode=require"
POSTGRES_USER="default"
POSTGRES_HOST="your-db-host.postgres.vercel-storage.com"
POSTGRES_PASSWORD="your-password"
POSTGRES_DATABASE="verceldb"

# -----------------------------------------------------------------------------
# CACHE (Vercel KV / Redis)
# -----------------------------------------------------------------------------
# Get these from Vercel Dashboard > Storage > KV
KV_URL="redis://default:password@your-kv-host.kv.vercel-storage.com:6379"
KV_REST_API_URL="https://your-kv-host.kv.vercel-storage.com"
KV_REST_API_TOKEN="your-kv-token"
KV_REST_API_READ_ONLY_TOKEN="your-read-only-token"

# -----------------------------------------------------------------------------
# AI (xAI GROK)
# -----------------------------------------------------------------------------
# Get your API key from https://console.x.ai/
XAI_API_KEY="xai-your-api-key-here"

# -----------------------------------------------------------------------------
# EXCHANGE (Binance)
# -----------------------------------------------------------------------------
# Get API keys from https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/
#
# SECURITY RECOMMENDATIONS:
# 1. Enable IP whitelist
# 2. Disable withdrawal permissions
# 3. Start with testnet for development
BINANCE_API_KEY="your-binance-api-key"
BINANCE_API_SECRET="your-binance-api-secret"

# Set to 'true' to use Binance Testnet (RECOMMENDED for development)
# Set to 'false' for LIVE trading (use with caution!)
BINANCE_TESTNET=true

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
# Your app URL (update for production)
NEXT_PUBLIC_APP_URL="http://localhost:3003"

# Environment
NODE_ENV="development"

# Enable auto-trading (false = signals only, true = execute trades)
# WARNING: Only enable after thorough testing!
ENABLE_AUTO_TRADING=false

# -----------------------------------------------------------------------------
# OPTIONAL: Monitoring & Logging
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking (optional)
# SENTRY_DSN="https://...@sentry.io/..."

# Log level: debug, info, warn, error
# LOG_LEVEL="info"

# -----------------------------------------------------------------------------
# OPTIONAL: WebSocket Server
# -----------------------------------------------------------------------------
# WebSocket server port for real-time updates
# WS_PORT=3004
