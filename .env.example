# =============================================================================
# Cryonix Environment Variables
# =============================================================================
# Copy to .env (production: ~/cryonix/.env) or apps/web/.env.local (dev)
# NEVER commit real values to git.

# -----------------------------------------------------------------------------
# Binance Exchange (required)
# -----------------------------------------------------------------------------
# Get API keys from https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/
# Security: enable IP whitelist, disable withdrawal permissions
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
BINANCE_TESTNET=false              # true for paper trading on testnet

# -----------------------------------------------------------------------------
# AI / Grok (required for trade validation)
# -----------------------------------------------------------------------------
# Get your API key from https://console.x.ai/
XAI_API_KEY=xai-your-key           # Grok API key from x.ai

# -----------------------------------------------------------------------------
# Database (required)
# -----------------------------------------------------------------------------
POSTGRES_URL=postgres://postgres:password@localhost:5432/cryonix
POSTGRES_PASSWORD=password          # Used by Docker postgres container

# -----------------------------------------------------------------------------
# Redis (required)
# -----------------------------------------------------------------------------
KV_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Trading Mode (optional -- defaults shown)
# -----------------------------------------------------------------------------
# TRADING_MODE=margin              # spot | margin | future (default: margin in prod)
# MARGIN_TYPE=cross                # cross | isolated (default: cross)
# DEFAULT_LEVERAGE=3               # Leverage multiplier (default: 3)

# -----------------------------------------------------------------------------
# Docker-only (set in docker-compose.prod.yml, not in .env)
# -----------------------------------------------------------------------------
# These are internal Docker network URLs -- do not set in .env
# ENGINE_URL=http://engine:8000        # Web -> Engine health check
# NEXTJS_API_URL=http://web:3000       # Engine -> Web signal persistence
# CRYONIX_ENV=production               # Guards live execution in engine
# ENABLE_AUTO_TRADING=true             # Enables auto-trading in web container
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# WebSocket Server (optional -- defaults shown)
# -----------------------------------------------------------------------------
# WS_PORT=3004                     # WebSocket server port for real-time updates

# -----------------------------------------------------------------------------
# Telegram Scraper (optional -- for external signal scraping)
# -----------------------------------------------------------------------------
# TELEGRAM_API_ID=                 # From my.telegram.org
# TELEGRAM_API_HASH=               # From my.telegram.org
# TELEGRAM_SESSION=                # Generated by setup_session.py (StringSession)
# TELEGRAM_CHANNELS=               # Comma-separated: CoinCodeCap,FatPigSignals,RavenTradingPro
# CONFIDENCE_BOOST_ENABLED=false   # false=log only, true=boost confidence scores

# -----------------------------------------------------------------------------
# Telegram Bots (optional -- for Telegram command interface)
# -----------------------------------------------------------------------------
# Interactive bot (@cryptonixis_bot) -- dashboard commands via Telegram
# TELEGRAM_INTERACTIVE_BOT_TOKEN=  # Token from @BotFather
# TELEGRAM_CHAT_ID=                # Your chat ID for notifications

# Evolution report bot (@cryonixEvolution_bot) -- evolution + deploy alerts
# TELEGRAM_BOT_TOKEN=              # Token from @BotFather (also used by health-monitor.sh)

# -----------------------------------------------------------------------------
# CoinMarketCap (optional -- for macro data in CMCScout)
# -----------------------------------------------------------------------------
# Also requires coinmarketcap.enabled=true in cryonix.toml
# CMC_API_KEY=                     # Free tier from https://coinmarketcap.com/api/
