# Cryonix Production Caddyfile
# Access via http://openclaw-vm (Tailscale) or http://<vm-ip>

:80 {
    # Dashboard + API
    reverse_proxy web:3000

    # WebSocket upgrade support
    @ws {
        header Connection *Upgrade*
        header Upgrade websocket
        path /ws
    }
    reverse_proxy @ws ws-server:3004
}
