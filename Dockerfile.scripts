# Lightweight container for background scripts (auto-trader, ws-server)
FROM node:20-alpine

WORKDIR /app

# ws-server.mjs needs the ws package, auto-trader.mjs only uses native fetch
RUN npm install --no-save ws@8 pg@8 ioredis@5 dotenv@16

COPY scripts/auto-trader.mjs scripts/ws-server.mjs scripts/telegram-interactive.mjs ./scripts/

USER node
