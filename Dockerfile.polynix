# Dockerfile.polynix — Polynix Polymarket binary options agent
FROM node:20-alpine

RUN apk add --no-cache git

WORKDIR /app

# Install runtime dependencies (same approach as Dockerfile.aktienix)
RUN npm install --no-save \
    @iarna/toml@2 \
    dotenv@16 \
    ioredis@5 \
    pg@8

# Stub for @cryonix/types — all imports are `import type` (erased by tsx at runtime)
RUN mkdir -p node_modules/@cryonix/types && \
    echo '{"name":"@cryonix/types","version":"1.0.0","main":"index.js"}' > node_modules/@cryonix/types/package.json && \
    echo 'module.exports = {};' > node_modules/@cryonix/types/index.js

# Copy agent source
COPY packages/agents/src/ ./packages/agents/src/

# Copy runner script
COPY scripts/services/polynix-runner.ts scripts/services/

# Copy config
COPY polynix.toml ./

CMD ["npx", "tsx", "scripts/services/polynix-runner.ts"]
