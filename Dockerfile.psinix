# Dockerfile.psinix — Ψnix Phase Convergence Trading Agent
FROM node:20-alpine

WORKDIR /app

# Install runtime dependencies
RUN npm install --no-save \
    @iarna/toml@2 \
    ccxt@4 \
    dotenv@16 \
    ioredis@5 \
    pg@8 \
    ws@8 \
    zod@3 \
    tsx@4 \
    typescript@5

# Stub for @cryonix/types
RUN mkdir -p node_modules/@cryonix/types && \
    echo '{"name":"@cryonix/types","version":"1.0.0","main":"index.js"}' > node_modules/@cryonix/types/package.json && \
    echo 'module.exports = {};' > node_modules/@cryonix/types/index.js

# Copy agent source
COPY packages/agents/src/ ./packages/agents/src/

# Copy runner + config
COPY scripts/services/psinix-runner.ts ./scripts/services/
COPY scripts/lib/ ./scripts/lib/
COPY scripts/strategy-lab/psinix_backtest.ts ./scripts/strategy-lab/

USER node
CMD ["npx", "tsx", "scripts/services/psinix-runner.ts"]
