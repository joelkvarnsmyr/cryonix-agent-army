# Dockerfile.alphanix — Alphanix multi-asset AI trading army
FROM node:20-alpine

RUN apk add --no-cache git python3

WORKDIR /app

# Install tsx globally so CMD doesn't fetch at runtime
RUN npm install -g tsx

# Install runtime dependencies
RUN npm install --no-save \
  dotenv ccxt @alpacahq/alpaca-trade-api @iarna/toml ioredis pg

# Stub for @cryonix/types — all imports are `import type` (erased by tsx at runtime)
RUN mkdir -p node_modules/@cryonix/types && \
    echo '{"name":"@cryonix/types","version":"1.0.0","main":"index.js"}' > node_modules/@cryonix/types/package.json && \
    echo 'module.exports = {};' > node_modules/@cryonix/types/index.js

# Copy agent source (maintains relative import paths from scripts/)
COPY packages/agents/src/ ./packages/agents/src/

# Copy runner + brain scripts
COPY scripts/services/alphanix-runner.ts ./scripts/services/
COPY scripts/services/alphanix-brain.ts ./scripts/services/

# Copy config
COPY alphanix.toml ./

CMD ["npx", "tsx", "scripts/services/alphanix-runner.ts"]
